# Ushbu faylni ".env" nomi bilan nusxalang va o'zingizga moslab o'zgartiring:
#   cp .env.example .env

# MySQL "root" foydalanuvchisi paroli (barcha xizmatlar shu bazani ishlatadi)
DB_PASSWORD=trinity

# --- Tashqi (host) portlar ---
# Bular docker-compose.yml da qattiq (o'zgarmas) yozilgan:
# MySQL=3307, Bnet login=1119, Bnet REST=8081, World=8085, Web=8098.
# O'zgartirish kerak bo'lsa docker-compose.yml dagi "ports:" qatorlarini tahrirlang.

# O'yin mijozlariga ko'rsatiladigan tashqi IP/domen (production uchun real IP/domen kiriting)
SERVER_EXTERNAL_ADDRESS=127.0.0.1
SERVER_LOCAL_ADDRESS=127.0.0.1

# Veb-sayt sessiyalari uchun maxfiy kalit (production uchun uzun, tasodifiy qiymat qo'ying)
SESSION_SECRET=bfa-uzbek-comunity-betta-maxfiy-kalit

# TrinityCore build paytida ishlatiladigan parallel jarayonlar soni.
# Kamroq RAM bo'lsa (masalan 8GB dan kam), buni 2 ga tushiring.
BUILD_JOBS=4

# --- ADMIN akkaunt (avtomatik yaratiladi) ---
# Bu login/parol bilan SAYTGA ("Admin panel" bilan) va (worldserver + xarita
# ma'lumotlari sozlangach) O'YINGA ham to'liq GM/administrator huquqi bilan
# kirish mumkin bo'ladi. Konteyner har safar ishga tushganda ushbu login mavjud
# bo'lmasa - yaratiladi, mavjud bo'lsa - paroli shu qiymatga moslanadi.
#
# DIQQAT: bu qiymatlarni FAQAT shu ".env" faylida saqlang (u .gitignore orqali
# Git-dan chetlashtirilgan) - hech qachon Git-ga commit qilinadigan boshqa
# fayllarga (masalan README) haqiqiy parolni yozmang.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=parolingizni-shu-yerga-yozing
